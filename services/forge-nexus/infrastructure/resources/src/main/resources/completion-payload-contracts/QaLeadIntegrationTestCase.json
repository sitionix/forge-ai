{
  "payloadType": "QaLeadIntegrationTestCase",
  "description": "One backend integration test case proposed by QA lead.",
  "fields": [
    { "name": "title", "type": "STRING", "required": true, "description": "Human-readable test case title." },
    { "name": "flow", "type": "OBJECT", "required": true, "description": "Integration flow or operation under test.", "objectType": "QaLeadIntegrationFlow" },
    { "name": "given", "type": "ARRAY", "required": true, "description": "Preconditions and fixture setup.", "itemType": "STRING" },
    { "name": "when", "type": "ARRAY", "required": true, "description": "Actions performed by the test.", "itemType": "STRING" },
    { "name": "then", "type": "ARRAY", "required": true, "description": "Expected outcomes and assertions.", "itemType": "STRING" },
    { "name": "dataChecks", "type": "ARRAY", "required": true, "description": "Persistence, message, or response data checks.", "itemType": "OBJECT", "itemObjectType": "QaLeadDataCheck" },
    { "name": "priority", "type": "STRING", "required": true, "description": "Test priority such as high, medium, or low." }
  ]
}
