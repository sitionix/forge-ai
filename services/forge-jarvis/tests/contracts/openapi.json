      "JarvisQueryIntent": {
        "description": "An enumeration.",
        "enum": [
          "FLOW_EXPLANATION",
          "COMPONENT_USAGE",
          "COMPONENT_RESPONSIBILITY",
          "CODE_LOCATION",
          "ARCHITECTURE_OVERVIEW",
          "UNKNOWN"
        ],
        "title": "JarvisQueryIntent",
        "type": "string"
      },
      "JarvisQueryRequest": {
        "additionalProperties": false,
        "properties": {
          "answerLanguage": {
            "default": "en",
            "minLength": 1,
            "title": "Answerlanguage",
            "type": "string"
          },
          "includeTests": {
            "default": false,
            "title": "Includetests",
            "type": "boolean"
          },
          "intent": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JarvisQueryIntent"
              }
            ],
            "default": "UNKNOWN"
          },
          "maxFlows": {
            "default": 10,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Maxflows",
            "type": "integer"
          },
          "queryText": {
            "minLength": 1,
            "title": "Querytext",
            "type": "string"
          }
        },
        "required": [
          "queryText"
        ],
        "title": "JarvisQueryRequest",
        "type": "object"
      },
      "JarvisQueryResponse": {
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "title": "Coverage",
            "type": "object"
          },
          "diagnostics": {
            "items": {
              "type": "object"
            },
            "title": "Diagnostics",
            "type": "array"
          },
          "flows": {
            "items": {
              "type": "object"
            },
            "title": "Flows",
            "type": "array"
          },
          "intent": {
            "title": "Intent",
            "type": "string"
          },
          "matchedNodes": {
            "items": {
              "type": "object"
            },
            "title": "Matchednodes",
            "type": "array"
          },
          "matchedSources": {
            "items": {
              "type": "object"
            },
            "title": "Matchedsources",
            "type": "array"
          },
          "queryId": {
            "title": "Queryid",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JarvisQueryStatus"
          }
        },
        "required": [
          "queryId",
          "status",
          "intent"
        ],
        "title": "JarvisQueryResponse",
        "type": "object"
      },
      "JarvisQueryStatus": {
        "description": "An enumeration.",
        "enum": [
          "OK",
          "NO_CANDIDATES",
          "AMBIGUOUS",
          "INVALID_REQUEST",
          "QUERY_FAILED"
        ],
        "title": "JarvisQueryStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
