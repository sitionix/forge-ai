[Unit]
Description=Forge Nexus
After=network-online.target forge-agent.service
Wants=network-online.target

[Service]
Type=simple
User=@FORGE_SYSTEMD_USER@
Group=@FORGE_SYSTEMD_GROUP@
WorkingDirectory=@FORGE_AI_HOME@
EnvironmentFile=@FORGE_SYSTEMD_ENV_FILE@
EnvironmentFile=@FORGE_MCP_MATERIAL_DIR@/nexus.env
ExecStart=@FORGE_AI_HOME@/scripts/runtime/run-nexus.sh
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
