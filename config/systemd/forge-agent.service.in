[Unit]
Description=Forge Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=@FORGE_SYSTEMD_USER@
Group=@FORGE_SYSTEMD_GROUP@
WorkingDirectory=@FORGE_AI_HOME@
EnvironmentFile=@FORGE_SYSTEMD_ENV_FILE@
EnvironmentFile=@FORGE_MCP_MATERIAL_DIR@/agent.env
EnvironmentFile=-@FORGE_MCP_MATERIAL_DIR@/oauth-clients.env
ExecStart=@FORGE_AI_HOME@/scripts/runtime/run-agent.sh
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
NoNewPrivileges=false
SupplementaryGroups=forge-runtime

[Install]
WantedBy=multi-user.target
